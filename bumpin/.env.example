# Public app URL (for /qr page after Vercel deploy)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Postgres URL (session pooler) for guest session minting
DATABASE_URL=postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Map tiles (MapTiler recommended for production demo)
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key

# Optional Grok Bot API (when organisers provide credentials)
GROK_BOT_API_URL=
GROK_BOT_API_KEY=
